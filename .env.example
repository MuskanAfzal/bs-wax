# Server-only. Set these in Vercel Project Settings > Environment Variables.
# Supabase Connect > Transaction pooler URI (port 6543). URL-encode password characters.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=hive-portfolio
# Choose a strong unique password. No password is included in this archive.
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD
